{
  "name": "ashen-vigil",
  "version": "1.0.0",
  "private": true,
  "description": "Ashen Vigil, a dark-fantasy survivors-style roguelite for Android and iOS.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor \"#2a0a10\" --splashBackgroundColor \"#0a0610\""
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@revenuecat/purchases-capacitor": "^14.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/assets": "^4.0.0"
  }
}
